            </div>

            <div className="space-y-3">
              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="text-xs font-bold text-slate-600 block mb-1">日期</label>
                  <input required type="date" name="date" defaultValue={expenseModalState.data?.date || "2026-11-11"} className="w-full p-3 bg-slate-50 border border-slate-200 rounded-2xl text-xs font-bold outline-none" />
                </div>
                <div>
                  <label className="text-xs font-bold text-slate-600 block mb-1">金額 (JPY ¥)</label>
                  <input required type="number" name="amountJPY" defaultValue={expenseModalState.data?.amountJPY || 1000} className="w-full p-3 bg-slate-50 border border-slate-200 rounded-2xl text-xs font-bold outline-none" />
                </div>
              </div>

              <div>
                <label className="text-xs font-bold text-slate-600 block mb-1">品項名稱</label>
                <input required name="title" defaultValue={expenseModalState.data?.title || ""} placeholder="例如: 清水寺門票" className="w-full p-3 bg-slate-50 border border-slate-200 rounded-2xl text-xs font-bold outline-none" />
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="text-xs font-bold text-slate-600 block mb-1">付款人</label>
                  <input required name="payer" defaultValue={expenseModalState.data?.payer || "A"} placeholder="例如: A / B" className="w-full p-3 bg-slate-50 border border-slate-200 rounded-2xl text-xs font-bold outline-none" />
                </div>
                <div>
                  <label className="text-xs font-bold text-slate-600 block mb-1">支付方式</label>
                  <select name="paymentMethod" defaultValue={expenseModalState.data?.paymentMethod || "信用卡"} className="w-full p-3 bg-slate-50 border border-slate-200 rounded-2xl text-xs font-bold outline-none">
                    <option value="信用卡">💳 信用卡</option>
                    <option value="現金">💵 現金</option>
                    <option value="電子支付">📱 其他/ICOCA</option>
                  </select>
                </div>
              </div>

              <div>
                <label className="text-xs font-bold text-slate-600 block mb-1">AA 分帳選項</label>
                <select name="isSplit" defaultValue={expenseModalState.data?.isSplit !== false ? "true" : "false"} className="w-full p-3 bg-slate-50 border border-slate-200 rounded-2xl text-xs font-bold outline-none">
                  <option value="true">🤝 需分帳 (兩人均分 1/2)</option>
                  <option value="false">👤 個人消費 (不納入分帳)</option>
                </select>
              </div>

              <div>
                <label className="text-xs font-bold text-slate-600 block mb-1">備註說明</label>
                <input name="notes" defaultValue={expenseModalState.data?.notes || ""} placeholder="隨手備註..." className="w-full p-3 bg-slate-50 border border-slate-200 rounded-2xl text-xs outline-none" />
              </div>
            </div>

            <div className="flex gap-2 pt-2">
              <button type="button" onClick={() => setExpenseModalState({ open: false, mode: 'add', data: null })} className="w-1/2 py-2.5 rounded-xl border text-xs text-slate-600">取消</button>
              <button type="submit" className="w-1/2 py-2.5 rounded-xl bg-emerald-600 text-white text-xs font-bold shadow-md">儲存記帳</button>
            </div>
          </form>
        </div>
      )}

      {/* MODAL: ADD/EDIT SHOPPING */}
      {shoppingModalState.open && (
        <div className="fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4">
          <form 
            onSubmit={(e) => {
              e.preventDefault();
              const formData = new FormData(e.currentTarget);
              handleSaveShoppingItem({
                name: formData.get('name'),
                category: formData.get('category'),
                target: formData.get('target'),
                priceJPY: Number(formData.get('priceJPY')) || 0,
                qty: Number(formData.get('qty')) || 1,
                store: formData.get('store'),
                notes: formData.get('notes')
              });
            }}
            className="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-slate-100 space-y-4"
          >
            <div className="flex items-center justify-between border-b pb-3 border-slate-100">
              <h3 className="font-bold text-slate-800 text-base">
                {shoppingModalState.mode === 'edit' ? '編輯購物項目' : '新增購物項目'}
              </h3>
              <button type="button" onClick={() => setShoppingModalState({ open: false, mode: 'add', data: null })} className="text-slate-400 hover:text-slate-600">
                <X className="w-5 h-5" />
              </button>
            </div>

            <div className="space-y-3">
              <div>
                <label className="text-xs font-bold text-slate-600 block mb-1">商品名稱</label>
                <input required name="name" defaultValue={shoppingModalState.data?.name || ""} placeholder="例如: Curél 保濕乳霜" className="w-full p-3 bg-slate-50 border border-slate-200 rounded-2xl text-xs font-bold outline-none" />
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="text-xs font-bold text-slate-600 block mb-1">分類</label>
                  <select name="category" defaultValue={shoppingModalState.data?.category || "藥妝美妝"} className="w-full p-3 bg-slate-50 border border-slate-200 rounded-2xl text-xs font-bold outline-none">
                    <option value="藥妝美妝">藥妝美妝</option>
                    <option value="服飾配件">服飾配件</option>
                    <option value="零食伴手禮">零食伴手禮</option>
                    <option value="3C 電器">3C 電器</option>
                    <option value="其他">其他</option>
                  </select>
                </div>
                <div>
                  <label className="text-xs font-bold text-slate-600 block mb-1">對象</label>
                  <input name="target" defaultValue={shoppingModalState.data?.target || "自用"} placeholder="例如: 自用 / 伴手禮" className="w-full p-3 bg-slate-50 border border-slate-200 rounded-2xl text-xs outline-none" />
                </div>
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="text-xs font-bold text-slate-600 block mb-1">預估單價 (JPY ¥)</label>
                  <input type="number" name="priceJPY" defaultValue={shoppingModalState.data?.priceJPY || 1000} className="w-full p-3 bg-slate-50 border border-slate-200 rounded-2xl text-xs font-bold outline-none" />
                </div>
                <div>
                  <label className="text-xs font-bold text-slate-600 block mb-1">數量</label>
                  <input type="number" name="qty" defaultValue={shoppingModalState.data?.qty || 1} className="w-full p-3 bg-slate-50 border border-slate-200 rounded-2xl text-xs font-bold outline-none" />
                </div>
              </div>

              <div>
                <label className="text-xs font-bold text-slate-600 block mb-1">購買地點</label>
                <input name="store" defaultValue={shoppingModalState.data?.store || ""} placeholder="例如: 松本清 心齋橋店" className="w-full p-3 bg-slate-50 border border-slate-200 rounded-2xl text-xs outline-none" />
              </div>

              <div>
                <label className="text-xs font-bold text-slate-600 block mb-1">備註說明</label>
                <input name="notes" defaultValue={shoppingModalState.data?.notes || ""} placeholder="優惠折扣等注意事項..." className="w-full p-3 bg-slate-50 border border-slate-200 rounded-2xl text-xs outline-none" />
              </div>
            </div>

            <div className="flex gap-2 pt-2">
              <button type="button" onClick={() => setShoppingModalState({ open: false, mode: 'add', data: null })} className="w-1/2 py-2.5 rounded-xl border text-xs text-slate-600">取消</button>
              <button type="submit" style={{ backgroundColor: themeColor }} className="w-1/2 py-2.5 rounded-xl text-white text-xs font-bold shadow-md">新增</button>
            </div>
          </form>
        </div>
      )}

      {/* MODAL: ADD/EDIT FAVORITE */}
      {favoriteModalState.open && (
        <div className="fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4">
          <form 
            onSubmit={(e) => {
              e.preventDefault();
              const formData = new FormData(e.currentTarget);
              handleSaveFavorite({
                name: formData.get('name'),
                category: formData.get('category'),
                notes: formData.get('notes'),
                url: formData.get('url')
              });
            }}
            className="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-slate-100 space-y-4"
          >
            <div className="flex items-center justify-between border-b pb-3 border-slate-100">
              <h3 className="font-bold text-slate-800 text-base">新增口袋名單</h3>
              <button type="button" onClick={() => setFavoriteModalState({ open: false, mode: 'add', data: null })} className="text-slate-400 hover:text-slate-600">
                <X className="w-5 h-5" />
              </button>
            </div>

            <div className="space-y-3">
              <div>
                <label className="text-xs font-bold text-slate-600 block mb-1">景點/餐廳名稱</label>
                <input required name="name" placeholder="例如: 伏見稻荷大社" className="w-full p-3 bg-slate-50 border border-slate-200 rounded-2xl text-xs font-bold outline-none" />
              </div>
              <div>
                <label className="text-xs font-bold text-slate-600 block mb-1">類別</label>
                <select name="category" className="w-full p-3 bg-slate-50 border border-slate-200 rounded-2xl text-xs font-bold outline-none">
                  <option value="Sightseeing">📷 觀光景點</option>
                  <option value="Food">🍽️ 餐廳美食</option>
                </select>
              </div>
              <div>
                <label className="text-xs font-bold text-slate-600 block mb-1">備註說明</label>
                <textarea name="notes" rows={2} placeholder="推薦理由或預約細節..." className="w-full p-3 bg-slate-50 border border-slate-200 rounded-2xl text-xs outline-none" />
              </div>
              <div>
                <label className="text-xs font-bold text-slate-600 block mb-1">網址 (選填)</label>
                <input name="url" placeholder="https://..." className="w-full p-3 bg-slate-50 border border-slate-200 rounded-2xl text-xs outline-none" />
              </div>
            </div>

            <div className="flex gap-2 pt-2">
              <button type="button" onClick={() => setFavoriteModalState({ open: false, mode: 'add', data: null })} className="w-1/2 py-2.5 rounded-xl border text-xs text-slate-600">取消</button>
              <button type="submit" style={{ backgroundColor: themeColor }} className="w-1/2 py-2.5 rounded-xl text-white text-xs font-bold shadow-md">儲存口袋名單</button>
            </div>
          </form>
        </div>
      )}
    </div>
  );
}
