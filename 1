  switch (condition) {
    case 'Sun': return <Sun className="w-4 h-4 text-amber-500" />;
    case 'CloudSun': return <CloudSun className="w-4 h-4 text-orange-400" />;
    case 'Cloud': return <Cloud className="w-4 h-4 text-slate-400" />;
    case 'Rain': return <CloudRain className="w-4 h-4 text-blue-400" />;
    case 'Snow': return <CloudSnow className="w-4 h-4 text-indigo-300" />;
    default: return <Sun className="w-4 h-4 text-amber-500" />;
  }
};

function CurrencyConverterWidget({ themeColor }) {
  const [jpy, setJpy] = useState('10000');
  const [hkd, setHkd] = useState('515');
  const [rate] = useState(0.0515);

  const handleJpyChange = (val) => {
    setJpy(val);
    if (!val || isNaN(val)) { setHkd(''); return; }
    setHkd((Number(val) * rate).toFixed(2));
  };

  const handleHkdChange = (val) => {
    setHkd(val);
    if (!val || isNaN(val)) { setJpy(''); return; }
    setJpy((Number(val) / rate).toFixed(0));
  };

  return (
    <div className="bg-white p-6 rounded-3xl border border-slate-200/80 shadow-xs space-y-4">
      <div className="flex items-center justify-between border-b pb-3 border-slate-100">
        <h3 className="font-bold text-slate-800 text-sm flex items-center gap-2">
          <ArrowRightLeft className="w-4 h-4" style={{ color: themeColor }} /> 即時 JPY ⇄ HKD 匯率換算
        </h3>
        <span className="text-[11px] font-mono text-slate-400">當前匯率: 1 JPY ≈ {rate} HKD</span>
      </div>

      <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div className="space-y-1">
          <label className="text-xs font-semibold text-slate-500">日圓 (JPY ¥)</label>
          <div className="relative">
            <input
              type="number"
              value={jpy}
              onChange={(e) => handleJpyChange(e.target.value)}
              className="w-full p-3 bg-slate-50 border border-slate-200 rounded-2xl font-mono text-base font-bold text-slate-800 outline-none"
              placeholder="0"
            />
            <span className="absolute right-3 top-3 text-xs font-bold text-slate-400">JPY</span>
          </div>
        </div>

        <div className="space-y-1">
          <label className="text-xs font-semibold text-slate-500">港幣 (HKD $)</label>
          <div className="relative">
            <input
              type="number"
              value={hkd}
              onChange={(e) => handleHkdChange(e.target.value)}
              className="w-full p-3 bg-slate-50 border border-slate-200 rounded-2xl font-mono text-base font-bold text-slate-800 outline-none"
              placeholder="0"
            />
            <span className="absolute right-3 top-3 text-xs font-bold text-slate-400">HKD</span>
          </div>
        </div>
      </div>

      <div className="flex flex-wrap gap-2 pt-2">
        {['1000', '5000', '10000', '50000'].map(val => (
          <button
            key={val}
            onClick={() => handleJpyChange(val)}
            className="text-xs bg-slate-100 hover:bg-slate-200 text-slate-600 px-3 py-1.5 rounded-xl font-mono font-medium transition-colors"
          >
            ¥{Number(val).toLocaleString()}
          </button>
        ))}
      </div>
    </div>
  );
}

export default function App() {
  const [themeColor, setThemeColor] = useState(() => localStorage.getItem('jp_theme_color') || '#BC002D');
  const [fontSizePx, setFontSizePx] = useState(() => Number(localStorage.getItem('jp_font_size_px')) || 14);

  const [trips, setTrips] = useState(() => {
    const saved = localStorage.getItem('japan_travel_trips');
    if (saved) {
      try { return JSON.parse(saved); } catch (e) { console.error(e); }
    }
    return INITIAL_TRIPS;
  });

  const [activeTripId, setActiveTripId] = useState(() => {
    const savedId = localStorage.getItem('japan_travel_active_id');
    if (savedId && trips.some(t => t.id === savedId)) return savedId;
    return trips[0]?.id || "";
  });

  const [activeTab, setActiveTab] = useState('dashboard');
  const [selectedDayIndex, setSelectedDayIndex] = useState(0);

  const [showAddTripModal, setShowAddTripModal] = useState(false);
  const [showEditBudgetModal, setShowEditBudgetModal] = useState(false);
  const [activityModalState, setActivityModalState] = useState({ open: false, mode: 'add', data: null });
  const [shoppingModalState, setShoppingModalState] = useState({ open: false, mode: 'add', data: null });
  const [favoriteModalState, setFavoriteModalState] = useState({ open: false, mode: 'add', data: null });
  const [expenseModalState, setExpenseModalState] = useState({ open: false, mode: 'add', data: null });
  
  // Modal for selecting target day when inserting favorite item
  const [addToItineraryModal, setAddToItineraryModal] = useState({ open: false, favItem: null, targetDayIndex: 0 });

  const [shoppingStatusFilter, setShoppingStatusFilter] = useState('all'); // all, bought, pending
  const [shoppingCategoryFilter, setShoppingCategoryFilter] = useState('all');

  useEffect(() => {
    localStorage.setItem('japan_travel_trips', JSON.stringify(trips));
  }, [trips]);

  useEffect(() => {
    localStorage.setItem('japan_travel_active_id', activeTripId);
  }, [activeTripId]);

  useEffect(() => {
    localStorage.setItem('jp_theme_color', themeColor);
  }, [themeColor]);

  useEffect(() => {
    localStorage.setItem('jp_font_size_px', fontSizePx.toString());
  }, [fontSizePx]);

  const activeTrip = useMemo(() => trips.find(t => t.id === activeTripId) || trips[0], [trips, activeTripId]);

  const calculateDays = (start, end) => {
    if (!start || !end) return 1;
    const s = new Date(start);
    const e = new Date(end);
    const diffTime = Math.abs(e - s);
    return Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;
  };

  const getCountdownProgress = (startDate) => {
    if (!startDate) return { days: 0, progressPercent: 100 };
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const start = new Date(startDate);
    start.setHours(0, 0, 0, 0);

    const diffDays = Math.ceil((start - today) / (1000 * 60 * 60 * 24));
    let progressPercent = 0;
    if (diffDays <= 0) {
      progressPercent = 100;
    } else if (diffDays <= 30) {
      progressPercent = Math.max(10, Math.min(95, ((30 - diffDays) / 30) * 100));
    } else {
      progressPercent = 10;
    }
    return { days: diffDays, progressPercent };
  };

  const getTotalSpent = (trip) => {
    if (!trip) return 0;
    const itinerarySpent = trip.dailyItinerary?.reduce((acc, day) => {
      return acc + (day.activities?.reduce((sum, act) => sum + (Number(act.cost) || 0), 0) || 0);
    }, 0) || 0;

    const expensesSpent = trip.expensesList?.reduce((acc, exp) => acc + (Number(exp.amountJPY) || 0), 0) || 0;

    return itinerarySpent + expensesSpent;
  };

  const filteredShoppingList = useMemo(() => {
    if (!activeTrip || !activeTrip.shoppingList) return [];
    return activeTrip.shoppingList.filter(item => {
      const matchStatus = 
        shoppingStatusFilter === 'all' ? true :
        shoppingStatusFilter === 'bought' ? item.bought :
        !item.bought;

      const matchCategory = 
        shoppingCategoryFilter === 'all' ? true :
        item.category === shoppingCategoryFilter;

      return matchStatus && matchCategory;
    });
  }, [activeTrip, shoppingStatusFilter, shoppingCategoryFilter]);

  const handleCreateTrip = (newTripData) => {
    const daysCount = calculateDays(newTripData.startDate, newTripData.endDate);
    const itinerary = [];
    const start = new Date(newTripData.startDate);
    
    for (let i = 0; i < daysCount; i++) {
      const currentDate = new Date(start);
      currentDate.setDate(start.getDate() + i);
      const dateStr = currentDate.toISOString().split('T')[0];
      
      itinerary.push({
        day: i + 1,
        date: dateStr,
        weather: { condition: "Sun", label: "晴朗", tempMin: 12, tempMax: 20 },
        activities: []
      });
    }

    const createdTrip = {
      id: `trip-${Date.now()}`,
      title: newTripData.title || "全新日本之旅",
      destination: newTripData.destination || "東京・日本",
      startDate: newTripData.startDate,
      endDate: newTripData.endDate,
      coverImage: newTripData.coverImage || "https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?auto=format&fit=crop&w=1200&q=80",
      budgetGoal: Number(newTripData.budgetGoal) || 200000,
      dailyItinerary: itinerary,
      checklist: [],
      shoppingList: [],
      favoritesList: [],
      expensesList: []
    };

    setTrips(prev => [createdTrip, ...prev]);
    setActiveTripId(createdTrip.id);
    setShowAddTripModal(false);
  };

  const handleSaveExpense = (formData) => {
    if (!activeTrip) return;
    let list = [...(activeTrip.expensesList || [])];

    if (expenseModalState.mode === 'edit') {
      list = list.map(item => item.id === expenseModalState.data.id ? { ...item, ...formData } : item);
    } else {
      const newItem = { id: `exp-${Date.now()}`, ...formData };
      list.push(newItem);
    }

    list.sort((a, b) => (b.date || '').localeCompare(a.date || ''));
    const updatedTrip = { ...activeTrip, expensesList: list };
    setTrips(trips.map(t => t.id === activeTrip.id ? updatedTrip : t));
    setExpenseModalState({ open: false, mode: 'add', data: null });
  };

  const handleToggleExpenseSplit = (expId) => {
    if (!activeTrip) return;
    const list = (activeTrip.expensesList || []).map(item => 
      item.id === expId ? { ...item, isSplit: !item.isSplit } : item
    );
    setTrips(trips.map(t => t.id === activeTrip.id ? { ...activeTrip, expensesList: list } : t));
  };

  const handleDeleteExpense = (expId) => {
    if (!activeTrip) return;
    const list = (activeTrip.expensesList || []).filter(i => i.id !== expId);
    setTrips(trips.map(t => t.id === activeTrip.id ? { ...activeTrip, expensesList: list } : t));
  };

  const handleUpdateBudgetGoal = (newGoal) => {
    if (!activeTrip) return;
    const updated = { ...activeTrip, budgetGoal: Number(newGoal) || 0 };
    setTrips(trips.map(t => t.id === activeTrip.id ? updated : t));
    setShowEditBudgetModal(false);
  };

  const handleSaveActivity = (formData) => {
    if (!activeTrip) return;
    const updatedDaily = [...activeTrip.dailyItinerary];
    const currentDayObj = updatedDaily[selectedDayIndex];
    let activities = [...(currentDayObj.activities || [])];

    if (activityModalState.mode === 'edit') {
      activities = activities.map(act => act.id === activityModalState.data.id ? { ...act, ...formData } : act);
    } else {
      const newAct = { id: `act-${Date.now()}`, ...formData };
      activities.push(newAct);
    }

    activities.sort((a, b) => (a.time || '').localeCompare(b.time || ''));
    currentDayObj.activities = activities;

    const updatedTrip = { ...activeTrip, dailyItinerary: updatedDaily };
    setTrips(trips.map(t => t.id === activeTrip.id ? updatedTrip : t));
    setActivityModalState({ open: false, mode: 'add', data: null });
  };

  const handleDeleteActivity = (actId) => {
    if (!activeTrip) return;
    const updatedDaily = [...activeTrip.dailyItinerary];
    const currentDayObj = updatedDaily[selectedDayIndex];
    currentDayObj.activities = currentDayObj.activities.filter(a => a.id !== actId);

    const updatedTrip = { ...activeTrip, dailyItinerary: updatedDaily };
    setTrips(trips.map(t => t.id === activeTrip.id ? updatedTrip : t));
  };

  const handleMoveActivity = (actIndex, direction) => {
    if (!activeTrip) return;
    const updatedDaily = [...activeTrip.dailyItinerary];
    const activities = [...updatedDaily[selectedDayIndex].activities];
    const targetIndex = direction === 'up' ? actIndex - 1 : actIndex + 1;
    if (targetIndex < 0 || targetIndex >= activities.length) return;

    const temp = activities[actIndex];
    activities[actIndex] = activities[targetIndex];
    activities[targetIndex] = temp;

    updatedDaily[selectedDayIndex].activities = activities;
    const updatedTrip = { ...activeTrip, dailyItinerary: updatedDaily };
    setTrips(trips.map(t => t.id === activeTrip.id ? updatedTrip : t));
  };

  const handleSaveShoppingItem = (formData) => {
    if (!activeTrip) return;
    let list = [...(activeTrip.shoppingList || [])];

    if (shoppingModalState.mode === 'edit') {
      list = list.map(item => item.id === shoppingModalState.data.id ? { ...item, ...formData } : item);
    } else {
      const newItem = { id: `shop-${Date.now()}`, bought: false, ...formData };
      list.push(newItem);
    }

    const updatedTrip = { ...activeTrip, shoppingList: list };
    setTrips(trips.map(t => t.id === activeTrip.id ? updatedTrip : t));
    setShoppingModalState({ open: false, mode: 'add', data: null });
  };

  const handleToggleShoppingItem = (shopId) => {
    if (!activeTrip) return;
